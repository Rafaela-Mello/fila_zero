PORT=3001
NODE_ENV=development

# Frontend (Vite / Vercel)
FRONTEND_URL=http://localhost:5173

# Sessão — gere uma string aleatória longa
SESSION_SECRET=troque-por-uma-chave-secreta-bem-longa

# Google OAuth (opcional — só para "Entrar com Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Assistente IA (Ollama local). false = respostas mockadas; true = chama Ollama na máquina.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Supabase (Postgres) ---
# Project Settings → Database → Connection string → URI
# Prefira a connection string "Transaction" (pooler, porta 6543) na Vercel.
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# SSL do Postgres (deixe true/omitido na Supabase; false só em Postgres local sem SSL)
# DB_SSL=true

# Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage: crie um bucket público chamado "menu" (fotos do cardápio)
SUPABASE_MENU_BUCKET=menu

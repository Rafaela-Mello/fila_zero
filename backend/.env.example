PORT=3001
NODE_ENV=development

# Frontend (Vite)
FRONTEND_URL=http://localhost:5173

# Sessão — gere uma string aleatória longa
SESSION_SECRET=troque-por-uma-chave-secreta-bem-longa

# Google OAuth (opcional — só para "Entrar com Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Restaurantes próximos usam OpenStreetMap (Overpass) — gratuito, sem chave.

# Assistente IA (Ollama local). false = respostas mockadas; true = chama Ollama na máquina.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# MySQL — ao subir (npm run dev), o backend cria sozinho o banco e as tabelas.
# No WSL→MySQL Windows: DB_HOST costuma ser o IP vEthernet (ex.: 172.23.128.1).
DB_HOST=172.23.128.1
DB_PORT=3306
DB_USER=filazero
DB_PASSWORD=filazero123
DB_NAME=filazero_db
